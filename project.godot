; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are loss-less and defaults can be changed
; by the editor. Any custom variable added to this file will be removed.

config_version=5

[application]

config/name="Rhythm Platformer"
config/version="1.0.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.1", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

GameManager="*res://scripts/GameManager.gd"
AudioManager="*res://scripts/AudioManager.gd"
LevelManager="*res://scripts/LevelManager.gd"

[debug]

gdscript/warnings/unused_variable=1
gdscript/warnings/unused_parameter=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
